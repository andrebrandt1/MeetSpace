@MeetSpace.Api_HostAddress = https://localhost:8000
@bookingId = 1

### Create booking
POST {{MeetSpace.Api_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "roomId": 1,
  "bookedBy": "John Doe",
  "title": "Veckomöte",
  "startTime": "2026-10-15T09:00:00",
  "endTime": "2026-10-15T10:00:00"
}

### Update booking: 204 No Content
PUT {{MeetSpace.Api_HostAddress}}/api/bookings/{{bookingId}}
Content-Type: application/json

{
  "roomId": 1,
  "bookedBy": "John Doe",
  "title": "Uppdaterat veckomöte",
  "startTime": "2026-10-15T10:00:00",
  "endTime": "2026-10-15T11:00:00"
}

### Get all rooms
GET {{MeetSpace.Api_HostAddress}}/api/rooms
Accept: application/json

###

GET {{MeetSpace.Api_HostAddress}}/api/bookings/{{bookingId}}
Accept: application/json

###

GET {{MeetSpace.Api_HostAddress}}/api/bookings/0
Accept: application/json


### Skapa ett mötesrum
POST {{MeetSpace.Api_HostAddress}}/api/rooms
Content-Type: application/json

{
  "name": "Konferensrum Himlen",
  "description": "Stort konferensrum med utsikt över ett molntäckt landskap med harpspelande änglar.",
  "capacity": 10,
  "floor": 1000
}

### Testa flera valideringsfel
POST {{MeetSpace.Api_HostAddress}}/api/rooms
Content-Type: application/json

{
  "name": "Humlan",
  "description": "Beskrivning med avslutande blanksteg ",
  "capacity": 501,
  "floor": 1001
}

### Skapa ett rum utan beskrivning
POST {{MeetSpace.Api_HostAddress}}/api/rooms
Content-Type: application/json

{
  "name": "Lilla mötesrummet",
  "capacity": 4,
  "floor": 0
}
###

DELETE {{MeetSpace.Api_HostAddress}}/api/bookings/{{bookingId}}

###
