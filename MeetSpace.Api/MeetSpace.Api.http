@MeetSpace.Api_HostAddress = https://localhost:8000
@bookingId = 1

### Create booking
POST {{MeetSpace.Api_HostAddress}}/api/bookings
Content-Type: application/json
Accept: application/json

{
  "roomId": 1,
  "bookedBy": "John Doe",
  "title": "Veckomöte",
  "startTime": "2026-10-15T09:00:00",
  "endTime": "2026-10-15T10:00:00"
}

### Update booking: 204 No Content
PUT {{MeetSpace.Api_HostAddress}}/api/bookings/{{bookingId}}
Content-Type: application/json

{
  "roomId": 1,
  "bookedBy": "John Doe",
  "title": "Uppdaterat veckomöte",
  "startTime": "2026-10-15T10:00:00",
  "endTime": "2026-10-15T11:00:00"
}

### Get all rooms
GET {{MeetSpace.Api_HostAddress}}/api/rooms
Accept: application/json

###

GET {{MeetSpace.Api_HostAddress}}/api/bookings/{{bookingId}}
Accept: application/json




### Get specific room

GET {{MeetSpace.Api_HostAddress}}/api/rooms/100
Accept: application/json

### Get all bookings

GET {{MeetSpace.Api_HostAddress}}/api/bookings/0
Accept: application/json


### Skapa ett mötesrum
POST {{MeetSpace.Api_HostAddress}}/api/rooms
Content-Type: application/json

{
  "name": "Konferensrum Himlen",
  "description": "Stort konferensrum med utsikt över ett molntäckt landskap med harpspelande änglar.",
  "capacity": 10,
  "floor": 1000
}

### Testa flera valideringsfel
POST {{MeetSpace.Api_HostAddress}}/api/rooms
Content-Type: application/json

{
  "name": "Humlan",
  "description": "Beskrivning med avslutande blanksteg ",
  "capacity": 501,
  "floor": 1001
}

### Skapa ett rum utan beskrivning
POST {{MeetSpace.Api_HostAddress}}/api/rooms
Content-Type: application/json

{
  "name": "Lilla mötesrummet",
  "capacity": 4,
  "floor": 0
}
###

DELETE {{MeetSpace.Api_HostAddress}}/api/bookings/{{bookingId}}

###

### ===== Employees =====
@employeeId = 1

### Hämta alla medarbetare: 200
GET {{MeetSpace.Api_HostAddress}}/api/employees
Accept: application/json

### Hämta en medarbetare: 200
GET {{MeetSpace.Api_HostAddress}}/api/employees/{{employeeId}}
Accept: application/json

### Hämta medarbetare som inte finns: 404
GET {{MeetSpace.Api_HostAddress}}/api/employees/999999
Accept: application/json

### Skapa medarbetare: 201
POST {{MeetSpace.Api_HostAddress}}/api/employees
Content-Type: application/json

{
  "name": "Anna Andersson",
  "email": "anna@example.com"
}

### Skapa med e-post som redan finns: 409
POST {{MeetSpace.Api_HostAddress}}/api/employees
Content-Type: application/json

{
  "name": "Annan Anna",
  "email": "anna@example.com"
}

### Skapa med ogiltiga fält: 400
POST {{MeetSpace.Api_HostAddress}}/api/employees
Content-Type: application/json

{
  "name": "",
  "email": "inte-en-adress"
}

### Uppdatera medarbetare: 204
PUT {{MeetSpace.Api_HostAddress}}/api/employees/{{employeeId}}
Content-Type: application/json

{
  "name": "Anna Berg",
  "email": "anna.berg@example.com"
}

### Uppdatera medarbetare som inte finns: 404
PUT {{MeetSpace.Api_HostAddress}}/api/employees/999999
Content-Type: application/json

{
  "name": "Anna Berg",
  "email": "anna.berg@example.com"
}

### Uppdatera med ogiltig e-post: 400
PUT {{MeetSpace.Api_HostAddress}}/api/employees/{{employeeId}}
Content-Type: application/json

{
  "name": "Anna Berg",
  "email": "anna@"
}

### Radera medarbetare: 204
DELETE {{MeetSpace.Api_HostAddress}}/api/employees/{{employeeId}}

### Radera medarbetare som inte finns: 404
DELETE {{MeetSpace.Api_HostAddress}}/api/employees/999999

###
